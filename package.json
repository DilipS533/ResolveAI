{
  "name": "openloop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenLoop — give an outcome. We'll stay on it. An autonomous agent that owns unfinished outcomes until they are resolved.",
  "scripts": {
    "dev": "concurrently -n agent,web -c cyan,magenta \"bun run dev:agent\" \"bun run dev:web\"",
    "dev:agent": "bun --watch server/index.ts",
    "dev:web": "vite",
    "start": "bun server/index.ts",
    "build": "vite build",
    "typecheck": "tsc -b --noEmit",
    "demo": "bun scripts/demo.ts",
    "smoke": "bun scripts/smoke-api.ts",
    "reset": "bun scripts/reset.ts"
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
